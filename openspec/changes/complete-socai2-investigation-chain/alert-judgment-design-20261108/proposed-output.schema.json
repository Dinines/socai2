{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "true_positive",
        "false_positive",
        "benign",
        "needs_review"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^E[1-9][0-9]*$"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^E[1-9][0-9]*$"
            }
          }
        },
        "required": [
          "reason",
          "source_ids"
        ]
      }
    }
  },
  "required": [
    "verdict",
    "confidence",
    "rationale",
    "evidence_ids",
    "recommendations"
  ]
}
