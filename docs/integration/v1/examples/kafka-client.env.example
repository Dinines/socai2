# 外部后端示例模板：未应用，__...__必须替换；不会自动发消息
KAFKA_BOOTSTRAP_SERVERS=192.168.1.21:19093
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CAFILE=__LOCAL_PATH_TO_ISSUED_CA_PEM__
KAFKA_TOPIC_ALERTS_RAW=socai2.alerts.raw
KAFKA_TOPIC_ALERTS_FUSED=socai2.alerts.fused
# 独立后端消费者自己的group，示例尚未创建，不复用Fusion/Agents组
KAFKA_CONSUMER_GROUP=partner-backend-results-v1
# 下列STINGAISOC_*仅供外部对接程序采用，不是原服务自动识别变量
STINGAISOC_TENANT_ID=f6a5c700-69b8-44fc-8238-609362fb1a9f
STINGAISOC_SOURCE=__STABLE_SOURCE_NAME__
STINGAISOC_CONNECTOR_ID=__REGISTERED_CONNECTOR_UUID_OR_NULL__
STINGAISOC_API_BASE_URL=http://127.0.0.1:18000
STINGAISOC_API_TOKEN=__ISSUED_TENANT_SCOPED_READ_TOKEN__
# 无Kafka SASL/客户端证书值：当前SSL配置不能冒称已启客户端认证/ACL
