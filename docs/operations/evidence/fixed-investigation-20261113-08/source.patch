diff --git a/services/api/app/socai2/case_context_input.py b/services/api/app/socai2/case_context_input.py
new file mode 100644
index 000000000..3f740cd00
--- /dev/null
+++ b/services/api/app/socai2/case_context_input.py
@@ -0,0 +1,77 @@
+"""Business views of frozen H revisions and historical judgments, never prose edits."""
+import copy
+
+from .baseline_store import digest
+
+
+def kind(ref):
+    path = (ref.get("source_path") or "").split(".")
+    if ref["type"] == "result":
+        return "prior_result"
+    if ref["type"] != "artifact":
+        return None
+    if len(path) == 4 and path[1] == "tasks" and path[3] == "revision":
+        return "human_feedback"
+    if len(path) == 3 and path[1] == "adopted_task_revisions":
+        return "human_feedback"
+    if len(path) == 3 and path[1] == "prior_results":
+        return "prior_result"
+    return "current_assessment" if path == ["$", "current_assessment"] else None
+
+
+def select(ref, value, config, omissions):
+    category = kind(ref)
+    if category is None or not isinstance(value, dict):
+        return value
+    rule = config["context_input_selection"][category]
+    result = copy.deepcopy(value)
+
+    def remove(key, reason):
+        if key in result:
+            omissions.append({"ref": ref, "field": key, "reason": reason, "value_sha256": digest(result.pop(key))})
+
+    for key in rule["omit"]:
+        remove(key, "context_field_not_needed_for_model_task")
+    for key in rule["empty"]:
+        if result.get(key) is None or result.get(key) == "":
+            remove(key, "empty_context_optional")
+    if category == "prior_result" and (value.get("validation_state", "accepted") != "accepted"
+            or value.get("conclusion_state") == "unavailable" or not value.get("conclusion")):
+        remove("conclusion", "no_accepted_historical_conclusion")
+        result["conclusion_state"] = "unavailable"
+    return result
+
+
+def metadata(ref, original, config):
+    category = kind(ref)
+    if category is None or not isinstance(original, dict):
+        return {}
+    path = ref.get("source_path") or ""
+    use = ("adopted_feedback" if path.startswith("$.adopted_task_revisions.") else
+           "selected_comparison" if ref["type"] == "result" else category)
+    result = {"context_kind": category, "context_label": config["context_input_selection"]["labels"][use]}
+    identity = original.get("id") or (ref["id"] if ref["type"] == "result" else None)
+    if identity:
+        result["context_identity"] = str(identity)
+    if category == "human_feedback" and isinstance(original.get("result_scope"), dict):
+        result["original_scope"] = copy.deepcopy(original["result_scope"])
+    if category == "prior_result" and original.get("member_deliveries"):
+        # Only original membership is available here. Do not invent the old
+        # time/object scope; C6 receives that separately from frozen comparison.
+        result["original_scope"] = {"alert_ids": sorted({str(m["alert_id"]) for m in original["member_deliveries"]})}
+    return result
+
+
+def scope_key(row):
+    return "result_scope" if row.get("context_kind") == "human_feedback" else "declared_scope"
+
+
+def group_key(row):
+    if not row.get("context_identity"):
+        return None
+    return ("frozen_context", row["context_kind"], row["context_identity"], row["ref"]["role"],
+            tuple(row["alert_ids"]), digest(row.get("original_scope")), digest(row["value"]))
+
+
+def human_refs(value):
+    return [(key, value[key]) for key in ("source_refs", "result_source_refs") if key in value]
diff --git a/services/api/app/socai2/list_query.py b/services/api/app/socai2/list_query.py
new file mode 100644
index 000000000..b15c4047b
--- /dev/null
+++ b/services/api/app/socai2/list_query.py
@@ -0,0 +1,68 @@
+"""SQL selection and opaque seek cursors; never calls an HTTP or model service."""
+import base64
+import binascii
+from uuid import UUID
+
+from sqlalchemy import and_, case, or_
+
+from .baseline_store import StoreError, digest
+from .list_query_contracts import ListCursor
+from .program_facts import RANK
+
+
+def title_match(table, value):
+    escaped = value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+    predicate = table.c.title.ilike("%" + escaped + "%", escape="\\")
+    try:
+        return or_(predicate, table.c.id == UUID(value))
+    except ValueError:
+        return predicate
+
+
+def severity_rank(column):
+    return case(*[(column == value, rank) for value, rank in RANK.items()], else_=None)
+
+
+def time_filters(column, query):
+    return ([column >= query.time_from] if query.time_from is not None else []) + (
+        [column < query.time_to] if query.time_to is not None else [])
+
+
+def fingerprint(tenant, kind, query):
+    return digest({"tenant_id": str(tenant), "kind": kind,
+        **query.model_dump(mode="json", exclude={"limit", "cursor", "before_id"})})
+
+
+def read_cursor(tenant, kind, query, sort_by):
+    if query.cursor is None:
+        return None
+    try:
+        raw = base64.b64decode(query.cursor, altchars=b"-_", validate=True)
+        point = ListCursor.model_validate_json(raw)
+        if (sort_by == "severity" and point.at is not None) or (sort_by != "severity" and point.rank is not None):
+            raise ValueError("wrong_sort_value")
+    except (ValueError, TypeError, binascii.Error):
+        raise StoreError("invalid_list_cursor", 422) from None
+    if point.kind != kind or point.sort_by != sort_by or point.filter_fingerprint != fingerprint(tenant, kind, query):
+        raise StoreError("list_cursor_filters_changed", 422)
+    return point
+
+
+def write_cursor(tenant, kind, query, sort_by, identity, value):
+    point = ListCursor(kind=kind, sort_by=sort_by, id=identity,
+        filter_fingerprint=fingerprint(tenant, kind, query),
+        **({"rank": value} if sort_by == "severity" else {"at": value}))
+    return base64.urlsafe_b64encode(point.model_dump_json().encode()).decode()
+
+
+def seek(column, identity, value, point_id, order):
+    after_id = identity > point_id if order == "asc" else identity < point_id
+    if value is None:
+        return and_(column.is_(None), after_id)
+    after_value = column > value if order == "asc" else column < value
+    return or_(after_value, and_(column == value, after_id), column.is_(None))
+
+
+def ordering(column, identity, order):
+    return ((column.asc().nulls_last(), identity.asc()) if order == "asc"
+            else (column.desc().nulls_last(), identity.desc()))
diff --git a/services/api/app/socai2/list_query_contracts.py b/services/api/app/socai2/list_query_contracts.py
new file mode 100644
index 000000000..e2ddeb9b8
--- /dev/null
+++ b/services/api/app/socai2/list_query_contracts.py
@@ -0,0 +1,77 @@
+"""Read-only query inputs shared by application readers, independent of HTTP."""
+from datetime import UTC
+from typing import Literal
+from uuid import UUID
+
+from pydantic import AwareDatetime, Field, StrictInt, field_validator, model_validator
+
+from .baseline_contracts import Contract
+from .enums import AlertStatus, AssignmentState, Severity, WorkStatus
+
+SortOrder = Literal["asc", "desc"]
+AlertSort = Literal["ingested_at", "event_time", "severity"]
+IncidentSort = Literal["created_at", "last_activity_at", "severity"]
+CaseSort = Literal["business_updated_at", "created_at", "severity"]
+EXTENDED_CASE_FIELDS = {"time_from", "time_to", "sort_by", "sort_order"}
+
+
+class DatedQuery(Contract):
+    time_from: AwareDatetime | None = None
+    time_to: AwareDatetime | None = None
+    sort_order: SortOrder | None = None
+
+    @field_validator("time_from", "time_to")
+    @classmethod
+    def utc_time(cls, value):
+        return value.astimezone(UTC) if value is not None else None
+
+    @model_validator(mode="after")
+    def ordered_window(self):
+        if self.time_from is not None and self.time_to is not None and self.time_from >= self.time_to:
+            raise ValueError("time_from_must_precede_time_to")
+        return self
+
+
+class SubjectListQuery(DatedQuery):
+    limit: int = Field(default=20, ge=1, le=50)
+    before_id: UUID | None = None
+    cursor: str | None = Field(default=None, max_length=1024)
+    q: str | None = Field(default=None, max_length=200)
+    severity: Severity | None = None
+    owner_id: UUID | None = None
+    assignment_state: AssignmentState | None = None
+
+    @field_validator("q")
+    @classmethod
+    def normalize_search(cls, value):
+        return (value.strip() or None) if value is not None else None
+
+    @property
+    def legacy(self):
+        return all(value is None for value in self.model_dump(exclude={"limit", "before_id", "cursor"}).values())
+
+    @model_validator(mode="after")
+    def old_pagination(self):
+        if self.before_id is not None and (self.cursor is not None or not self.legacy):
+            raise ValueError("before_id_cannot_combine_with_cursor_filters_or_sort")
+        return self
+
+
+class AlertListQuery(SubjectListQuery):
+    handling_status: AlertStatus | None = None
+    sort_by: AlertSort | None = None
+
+
+class IncidentListQuery(SubjectListQuery):
+    handling_status: WorkStatus | None = None
+    sort_by: IncidentSort | None = None
+
+
+class ListCursor(Contract):
+    version: Literal[2] = 2
+    kind: Literal["alerts", "incidents", "cases"]
+    sort_by: str
+    id: UUID
+    at: AwareDatetime | None = None
+    rank: StrictInt | None = Field(default=None, ge=0, le=4)
+    filter_fingerprint: str = Field(pattern=r"^[0-9a-f]{64}$")
