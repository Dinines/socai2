{
  "openapi": "3.1.0",
  "info": {
    "title": "UNREGISTERED asynchronous admission contract; execution not ready",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/socai2/cases/{case_id}/investigations": {
      "post": {
        "tags": [
          "socai2-cases"
        ],
        "summary": "提交案件检查或再次调查",
        "description": "保存任务后返回原受理ID及查询地址；202不等于调查已执行。",
        "operationId": "case_investigation_api_v1_socai2_cases__case_id__investigations_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisSubmitRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisTaskReceipt"
                }
              }
            }
          },
          "404": {
            "description": "subject_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordError"
                }
              }
            }
          },
          "409": {
            "description": "operation_conflict / subject_closed / empty_scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordError"
                }
              }
            }
          },
          "422": {
            "description": "invalid_input，或字段校验detail数组",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/RecordError"
                    },
                    {
                      "$ref": "#/components/schemas/RecordValidationError"
                    }
                  ],
                  "title": "Response 422 Case Investigation Api V1 Socai2 Cases  Case Id  Investigations Post"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable；同key重放恢复原受理身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordError"
                }
              }
            }
          }
        }
      }
    },
