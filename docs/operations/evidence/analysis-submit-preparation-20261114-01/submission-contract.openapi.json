  "components": {
    "schemas": {
      "AnalysisAttemptView": {
        "properties": {
          "attempt_no": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Attempt No",
            "description": "同任务的实际尝试序号，从1开始；不是内部attempt ID。"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id",
            "description": "本次真实Run；准备失败或尚未开始时可空。"
          },
          "run_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Url",
            "description": "该Run详情地址；无Run则为null。"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At",
            "description": "本次尝试实际开始时间，可能早于Run创建。"
          },
          "local_ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Local Ended At",
            "description": "本地实际收尾时间；不是Run的结束时间。"
          },
          "interruption_observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interruption Observed At",
            "description": "实际观察到执行中断的时间；未记录为null。"
          },
          "local_state": {
            "type": "string",
            "enum": [
              "running",
              "ended",
              "interrupted"
            ],
            "title": "Local State",
            "description": "本地执行状态，不替代Run结果。"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "completed",
                  "failed",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome",
            "description": "本次尝试结果；仍执行中为null。unknown不伪造确定结论。"
          },
          "failed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failed At",
            "description": "记录失败或未知结果的时间；没有则为null。"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code",
            "description": "保存的失败原因码；没有则为null。"
          },
          "error_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Stage",
            "description": "保存的失败阶段；没有则为null。"
          },
          "error_detail": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "type": "object"
