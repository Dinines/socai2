mpty","truncated":false,"captured_at":"2026-11-17T06:13:17.328571+00:00","limitations":["current_inventory_not_event_time_state","exact_name_or_ip_match_not_identity_proof","inventory_has_no_object_namespace_all_matches_retained"]},{"reason":null,"source":"threat_intel","outcome":"empty","truncated":false,"captured_at":"2026-11-17T06:13:17.365074+00:00","limitations":["tenant_internal_intelligence_only","no_hit_does_not_mean_safe","stored_score_not_case_confidence_or_proof_of_malice"]},{"reason":"tool_budget_reserved_for_evidence","source":"history","outcome":"not_attempted_budget","truncated":false,"captured_at":"2026-11-17T06:13:17.374972+00:00","limitations":["recorded_alerts_only_not_complete_activity_history","same_object_not_causality","prior_triage_and_human_feedback_are_not_independent_observations","legacy_public_alerts_not_queried"]},{"reason":"source_not_connected","source":"ueba","outcome":"unavailable","truncated":false,"captured_at":"2026-11-17T06:13:17.399566+00:00","limitations":["current_risk_profile_is_prior_analysis_not_independent_observation","source_has_no_account_namespace_identity_match_unverified","stored_score_calculation_unverified","current_profile_not_case_window_history","no_profile_is_not_low_risk"]},{"reason":"source_not_connected","source":"knowledge","outcome":"unavailable","truncated":false,"captured_at":"2026-11-17T06:13:17.410729+00:00","limitations":["current_document_guidance_not_case_evidence","english_full_text_not_semantic_search","title_terms_are_retrieval_keys_not_verified_facts","retrieved_content_is_untrusted","current_document_not_reconstructed_at_case_time"]},{"reason":"source_not_connected","source":"graph","outcome":"unavailable","truncated":false,"captured_at":"2026-11-17T06:13:17.421779+00:00","limitations":["current_identity_graph_not_historical_business_state","account_match_not_identity_proof","graph_source_has_no_input_object_namespace","identity_context_not_attack_path_or_causality"]}]},"content_text":null,"av