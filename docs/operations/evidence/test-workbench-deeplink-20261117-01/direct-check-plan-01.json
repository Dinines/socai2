  "checks": [
    {
      "id": "R1",
      "stage": "report",
      "title": "显式配置生成真实轮次链接",
      "method_and_expected": "用已存会话及独立 --report-config 重生成到新目录；逐项解析6个 viewer_url，核三类主体、UUID和目标环境与保存身份完全一致，同Case两轮指向不同实际Run。Markdown入口和JSON一致；manifest记录同份公开配置。",
      "status": "not_executed"
    },
    {
      "id": "R2",
      "stage": "report",
      "title": "配置和旧入口兼容",
      "method_and_expected": "分别检查 report/session 菜单接线；不提供配置仍生成旧式报告，明确无页面链接；源标签不等于保存 environment.label、非规范身份、缺必需字段、非法协议、凭据、query或fragment应拒绝。显式源/目标标签允许不同，不从冻结profile推导或覆盖。",
      "status": "not_executed"
    },
    {
      "id": "R3",
      "stage": "report",
      "title": "未执行记录不虚构链接",
      "method_and_expected": "仅实际主体轮次产生链接；保留无Run任务/no_changes和原统计，不以task ID、计划ID、轮次数或latest拼造Run。报告重生不连接数据库、HTTP、Kafka或模型。",
      "status": "not_executed"
    },
    {
      "id": "P1",
      "stage": "page",
      "title": "首轮及后轮精确打开",
      "method_and_expected": "从新报告分别打开Case R1/R2，核所选Run、Result、冻结成员1/2及C1来源；R1不混入第二条告警，R2比较实际R1 Run及Result。事件两轮、两条告警的4个链接也分别核身份。",
      "status": "not_executed"
    },
    {
      "id": "P2",
      "stage": "page",
      "title": "首页外主体和完整目录",
      "method_and_expected": "受控回放将目标移出主体首页、将目标Run放入后续目录页；页面仍从指定详情和完整执行目录定位精确Run。明确记录此项为内存派生，不冒称21实际存在额外Case。",
      "status": "not_executed"
    },
    {
      "id": "P3",
      "stage": "page",
      "title": "错误目标明确失败",
      "method_and_expected": "缺任一参数、未知subject_type、非规范UUID、未知Run、不属于该主体的Run、错误环境、详情或trace身份不符、读取失败时保留目标并提示，绝不自动打开默认首条或latest；不产生业务操作。无任何参数仍走普通列表。",
      "status": "not_executed"
    },
    {
      "id": "P4",
      "stage": "page",
      "title": "选择与刷新保持",
      "method_and_expected": "R1链接打开后刷新、重载、隐藏恢复仍为R1；显式选择R2才改变目标。切换过程中旧请求不覆盖新主体/轮次详情或来源标识，复用既有generation机制做直接检查。",
      "status": "not_executed"
    },
    {
      "id": "P5",
      "stage": "page",
      "title": "逐轮测试标识保持",
      "method_and_expected": "复用已验lyc来源检查和6个存量HTTP Run；紫色按所选冻结成员识别，无账本仍可查看，旧账本仅exact Run生效。源读取失败只提示未知，已读流程可用；旧材料不改名，受控lyc变体明确区分真实原件。",
      "status": "not_executed"
    },
    {
      "id": "E1",
      "stage": "evidence",
      "title": "原件和原结论不变",
      "method_and_expected": "执行前后核本计划来源SHA及已冻结1036文件/旧报告manifest；新报告存新目录，模型输入/Schema/原答、统计与原质量结论一致，仅增加展示配置和链接。两轮accepted/uncertain/partial及已登记5项问题不得被链接接线改写成质量通过。",
      "status": "not_executed"
    },
    {
      "id": "E2",
      "stage": "evidence",
      "title": "本地只读证据与范围",
      "method_and_expected": "报告检查守卫网络入口，页面用已存HTTP回放或协调者本机只读预览。记录真实快照、受控负例与浏览器实际观察的区别；0新投递、模型、业务写和部署。独立复核只输出本目录证据，不修改产品、PROGRESS或OpenSpec。",
      "status": "not_executed"
    },
    {
      "id": "E3",
