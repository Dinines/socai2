:root{font-family:Inter,"PingFang SC","Microsoft YaHei",system-ui,sans-serif;color:#202d42;background:#f4f6fa;font-size:14px;line-height:1.6;color-scheme:light}
*{box-sizing:border-box}body{margin:0}button,a{touch-action:manipulation}button{font:inherit;color:#29476c;background:#fff;border:1px solid #ccd7e5;border-radius:7px;padding:6px 11px;cursor:pointer;text-align:left}button:hover{border-color:#5077aa;background:#edf4ff}button:disabled{opacity:.55;cursor:wait}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #71a7ed;outline-offset:2px}a{color:#245d9f}h1,h2,h3,h4,p{margin:0 0 10px}h1{font-size:24px;letter-spacing:.02em}h2{font-size:19px}h3{font-size:16px}h4{font-size:14px}.topbar{padding:23px 32px;background:#fff;border-bottom:1px solid #dce3ec;display:flex;justify-content:space-between;align-items:center;gap:24px}.eyebrow{color:#526b8c;font-size:11px;letter-spacing:.13em;font-weight:650}.service-info{text-align:right;max-width:55%;font-size:12px;overflow-wrap:anywhere;color:#627189}.workspace{display:grid;grid-template-columns:280px minmax(0,1fr);min-height:calc(100vh - 150px)}.sidebar{padding:24px 18px;border-right:1px solid #dce3ec;background:#f9fafc}.main-panel{padding:26px 30px;min-width:0;max-width:1600px}.section-heading,.batch-heading{display:flex;justify-content:space-between;align-items:start;gap:12px}.batch-choice{display:block;width:100%;margin:10px 0;padding:13px;background:#fff}.batch-choice[aria-current=true]{background:#eaf1fb;border-color:#6488b6;box-shadow:inset 3px 0 #386ca7}.batch-choice strong{display:block}.batch-choice small{display:block;color:#66748a;overflow-wrap:anywhere}.muted{color:#66748a}.small{font-size:12px}.tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}.tag{border-radius:5px;background:#edf1f7;color:#465e7d;padding:2px 7px;font-size:12px;overflow-wrap:anywhere}.tag.warn{background:#fff0cf;color:#795718}.tag.bad{background:#ffe6e3;color:#9e3e31}.tag.good{background:#e6f3ee;color:#286a51}.notice{padding:12px 15px;background:#eaf1fb;border:1px solid #c9daed;border-radius:8px;margin-bottom:16px;overflow-wrap:anywhere;white-space:pre-wrap}.notice.error{background:#fff0ed;border-color:#e9bcb6;color:#903d35}.tabs{display:flex;gap:6px;border-bottom:1px solid #d6dfe9;padding-bottom:10px;margin:24px 0 18px;flex-wrap:wrap}.tabs button{border-color:transparent;background:transparent}.tabs button[aria-selected=true]{background:#e3edf9;color:#225b99;font-weight:650}.card{padding:18px;border:1px solid #dce3ec;border-radius:10px;background:#fff;margin-bottom:14px;overflow-wrap:anywhere}.card p:last-child{margin-bottom:0}.card .actions{margin-top:12px}.actions{display:flex;gap:8px;flex-wrap:wrap}.identity{font-family:ui-monospace,SFMono-Regular,monospace;font-size:12px;overflow-wrap:anywhere;color:#52657e}.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px 22px;margin:14px 0}.facts div{min-width:0}.facts dt{font-size:12px;color:#687a92}.facts dd{margin:3px 0 0;overflow-wrap:anywhere;white-space:pre-wrap}.empty{padding:50px 24px;color:#64758b;text-align:center;border:1px dashed #cdd6e1;border-radius:10px}.more{display:block;margin:18px auto}.inspection{border-top:2px solid #cbd8e8;margin-top:30px;padding-top:22px}.inspection h2{font-size:19px}details{margin:12px 0}summary{color:#3c5e86;cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.65 ui-monospace,SFMono-Regular,Menlo,monospace;background:#f2f5f9;padding:16px;border-radius:7px;max-height:520px;overflow:auto}.prose{white-space:pre-wrap;overflow-wrap:anywhere}.metric-row{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.item-list{margin:8px 0;padding-left:22px}.subheading{margin:22px 0 10px}.content-panel{border-left:3px solid #7e9fc5;padding-left:16px;margin-top:15px}.body-status{font-size:12px;color:#66748a;margin:12px 0}footer{padding:14px 30px;display:flex;gap:30px;justify-content:space-between;border-top:1px solid #dce3ec;color:#6d7c91;font-size:12px;background:#fff}[hidden]{display:none!important}
@media(max-width:900px){.workspace{grid-template-columns:220px minmax(0,1fr)}.main-panel{padding:22px 18px}.topbar{padding:18px}.facts{grid-template-columns:1fr 1fr}}
@media(max-width:650px){.workspace{display:block}.sidebar{border-right:0;border-bottom:1px solid #dce3ec}.topbar{display:block}.service-info{text-align:left;max-width:none}.batch-heading{display:block}.facts{grid-template-columns:1fr}footer{display:block}.sidebar .batch-choice{margin:6px 0}}
