<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>调查测试查阅</title>
  <link rel="stylesheet" href="/viewer/assets/viewer.css">
  <script type="module" src="/viewer/assets/viewer.js"></script>
</head>
<body>
  <header class="topbar">
    <div><span class="eyebrow">SOCAI2 · 只读工作台</span><h1>调查测试查阅</h1></div>
    <div id="service-info" class="service-info">正在连接测试服务…</div>
  </header>
  <div id="global-error" class="notice error" role="alert" hidden></div>
  <main class="workspace">
    <aside class="sidebar" aria-label="测试批次">
      <div class="section-heading"><h2>测试批次</h2><button id="reload-batches" type="button">刷新列表</button></div>
      <div id="batch-list" aria-live="polite"></div>
      <button id="more-batches" class="more" type="button" hidden>加载更多批次</button>
      <p class="muted small">页面仅查阅已保存记录。刷新不会启动调查。</p>
    </aside>
    <section class="main-panel" aria-label="批次与调查记录">
      <div id="empty-selection" class="empty"><h2>选择一个测试批次</h2><p>查看用例、真实任务、调查结果与原始记录。</p></div>
      <div id="batch-panel" hidden>
        <div class="batch-heading"><div><div id="batch-tags" class="tags"></div><h2 id="batch-title"></h2><p id="batch-observation" class="muted small"></p></div><button id="refresh-selection" type="button">刷新当前记录</button></div>
        <div id="read-status" class="notice" role="status" hidden></div>
        <nav id="batch-tabs" class="tabs" aria-label="批次内容">
          <button type="button" data-tab="cases" aria-selected="true">用例</button>
          <button type="button" data-tab="operations">操作与任务</button>
          <button type="button" data-tab="preparation">准备</button>
          <button type="button" data-tab="quality">质量问题</button>
          <button type="button" data-tab="evidence">测试证据</button>
        </nav>
        <div id="tab-content" aria-live="polite"></div>
        <button id="more-records" class="more" type="button" hidden>加载更多</button>
        <section id="inspection" class="inspection" aria-label="调查记录详情" hidden>
          <div class="section-heading"><h2 id="inspection-title"></h2><button id="close-inspection" type="button">收起详情</button></div>
          <div id="inspection-body" aria-live="polite"></div>
        </section>
      </div>
    </section>
  </main>
  <footer><span id="viewer-version"></span><span>执行、交付、当前有效性和模型质量分别记录。</span></footer>
</body>
</html>
