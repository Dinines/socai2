        "tags": [
          "socai2-run-records"
        ],
        "summary": "完整分页读取调查步骤",
        "description": "返回真实步骤、输入/输出/复用原件来源。kind=tool仅列工具步骤；不启动分析或查询工具。",
        "operationId": "steps_api_v1_socai2_analysis_runs__run_id__steps_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "单页数量；省略使用profile默认值，上限由同一profile配置。",
              "title": "Limit"
            },
            "description": "单页数量；省略使用profile默认值，上限由同一profile配置。"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ],
              "description": "上一页next_cursor；保持Run和筛选条件一致。",
              "title": "Cursor"
            },
            "description": "上一页next_cursor；保持Run和筛选条件一致。"
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/StepKind"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStepPage"
                }
              }
            }
          },
          "404": {
            "description": "run_not_found / step_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordError"
                }
              }
