@@ -0,0 +1,51 @@
+"""Case file references; the business backend owns file storage and download."""
+from typing import Literal
+from uuid import UUID
+
+from pydantic import AwareDatetime, Field, field_validator
+
+from .baseline_contracts import Contract
+
+
+class CaseAttachmentCreate(Contract):
+    operation_key: UUID = Field(description="本次登记的幂等键；同案同作者同元数据重试沿用。")
+    file_id: str = Field(min_length=1, max_length=512, description="业务后端已保存文件的稳定ID，不是下载URL；文件内容变化须使用新ID。")
+    file_name: str = Field(min_length=1, max_length=512, description="业务后端提供的文件显示名，原值保存，不作为路径使用。")
+    mime_type: str = Field(min_length=1, max_length=255, description="业务后端声明的文件内容类型，例如application/pdf。")
+    size_bytes: int = Field(strict=True, ge=0, le=9223372036854775807, description="业务后端声明的完整文件字节数；本服务不读取文件核验。")
+    sha256: str | None = Field(default=None, pattern="^[0-9a-f]{64}$", description="业务后端提供的文件SHA-256；未知可省略或为null，不由本服务计算或验证。")
+
+    @field_validator("file_id", "file_name", "mime_type")
+    @classmethod
+    def text_metadata(cls, value):
+        if not value.strip() or any(ord(char) < 32 or ord(char) == 127 for char in value):
+            raise ValueError("attachment metadata must be nonblank text without control characters")
+        return value
+
+    @field_validator("file_id")
+    @classmethod
+    def file_identity(cls, value):
+        if "://" in value:
+            raise ValueError("file_id must be a backend file identity, not a URL")
+        return value
+
+
+class CaseAttachmentView(Contract):
+    id: UUID = Field(description="本服务保存的附件关联ID，不是业务后端文件ID。")
+    case_id: UUID = Field(description="附件明确归属的Case。")
+    file_id: str = Field(description="业务后端文件ID；由业务后端据此提供下载或报告文件失效。")
+    file_name: str = Field(description="登记时业务后端提供的文件显示名。")
+    mime_type: str = Field(description="登记时业务后端声明的文件内容类型，未经本服务检测。")
+    size_bytes: int = Field(ge=0, description="登记时业务后端声明的文件字节数，未经本服务核验。")
+    sha256: str | None = Field(description="业务后端提供的文件哈希；null表示未提供，不是校验失败。")
+    created_by: UUID = Field(description="实际登记人的认证用户ID，由服务端保存。")
+    created_at: AwareDatetime = Field(description="服务端保存附件关联的时间，不是文件发生时间。")
+    file_owner: Literal["business_backend"] = Field(description="文件字节、上传和下载统一由业务后端管理。")
+    availability: Literal["managed_by_backend"] = Field(description="本服务只提供引用，未探测文件实时存在性或可下载性；下载结果由业务后端决定。")
+
+
+class CaseAttachmentPage(Contract):
+    items: list[CaseAttachmentView] = Field(description="本服务登记到指定Case的附件，按created_at/id升序；不混入Run工件或其他案件。")
+    total: int = Field(ge=0, description="指定Case已登记附件引用的总数，不是探测可下载文件数。")
+    next_offset: int | None = Field(description="有后续记录时的下一页偏移，否则null；不承诺跨请求冻结快照。")
+    observed_at: AwareDatetime = Field(description="本次只读一致快照的观察时间。")
diff --git a/services/api/app/socai2/case_attachments.py b/services/api/app/socai2/case_attachments.py
new file mode 100644
index 000000000..e8f8a2a1a
--- /dev/null
+++ b/services/api/app/socai2/case_attachments.py
@@ -0,0 +1,81 @@
+"""Append/read external file references, without fetching or analyzing bytes."""
+from uuid import uuid5
+
+from sqlalchemy import func, insert, select, update
+
+from .baseline_store import C, F, StoreError, digest
+from .case_attachment_contracts import CaseAttachmentPage, CaseAttachmentView
+from .case_service import CaseService
+
+SCHEMA = "socai2.case-attachment-reference.v1"
+PREFIX = "business-backend-file:"
+ACTION = "case_attachment_linked"
+
+
+def view(row):
+    return CaseAttachmentView(id=row["id"], case_id=row["case_id"],
+        file_id=row["blob_ref"][len(PREFIX):], file_name=row["file_name"],
+        mime_type=row["mime_type"], size_bytes=row["size_bytes"], sha256=row["sha256"],
+        created_by=row["created_by"], created_at=row["captured_at"],
+        file_owner="business_backend", availability="managed_by_backend")
+
+
+class CaseAttachmentService(CaseService):
+    @staticmethod
+    def scope(store, case_id):
+        return store.where(F, F.c.case_id == case_id, F.c.kind == "attachment",
+            F.c.schema_version == SCHEMA, F.c.run_id.is_(None))
+
+    async def create(self, tenant_id, case_id, request, *, actor):
+        intent = digest({"actor": str(actor.user_id), "request": request.model_dump(mode="json")})
+        async with self.transaction(tenant_id) as store:
+            await self.actor(store, actor)
+            case = await store.case(case_id)
+            prior = await store.receipt(case_id, request.operation_key, ACTION)
+            if prior:
+                if prior["request_hash"] != intent:
+                    raise StoreError("operation_key_conflict")
+                return CaseAttachmentView.model_validate(prior["outcome"])
+            reference = PREFIX + request.file_id
+            if await store.one(select(F.c.id).where(*self.scope(store, case_id), F.c.blob_ref == reference)):
+                raise StoreError("attachment_already_linked")
+            now = await store.now()
+            identity = uuid5(case_id, "socai2.attachment:" + str(request.operation_key))
+            row = (await store.db.execute(insert(F).values(
+                id=identity, tenant_id=tenant_id, case_id=case_id, kind="attachment", schema_version=SCHEMA,
+                blob_ref=reference, file_name=request.file_name, mime_type=request.mime_type,
+                size_bytes=request.size_bytes, sha256=request.sha256, captured_at=now,
+                material_state="complete", source_refs=[], created_by=actor.user_id,
+                retention={"original_size_bytes": request.size_bytes, "original_sha256": request.sha256,
+                    "retained_size_bytes": None, "retained_sha256": None, "truncated": False,
+                    "reason": "business_backend_reference_only", "omitted_paths": []},
+            ).returning(F))).mappings().one()
+            out = view(row)
+            await store.db.execute(update(C).where(*store.where(C, C.c.id == case_id)).values(
+                row_version=C.c.row_version + 1, business_updated_at=now))
+            await store.event(case_id, request.operation_key, actor.snapshot(), ACTION,
+                {"request_hash": intent, "outcome": out.model_dump(mode="json")},
+                [("case_id", case_id, {"row_version": case["row_version"]},
+                  {"row_version": case["row_version"] + 1})])
+            return out
+
+    async def list(self, tenant_id, case_id, *, limit=20, offset=0):
+        if not 1 <= limit <= 100 or not 0 <= offset <= 100000:
+            raise StoreError("invalid_attachment_page", 422)
+        async with self.transaction(tenant_id, readonly=True) as store:
+            await store.case(case_id, lock=False)
+            scope = self.scope(store, case_id)
+            total = (await store.db.execute(select(func.count()).select_from(F).where(*scope))).scalar_one()
+            rows = (await store.db.execute(select(F).where(*scope)
+                .order_by(F.c.captured_at, F.c.id).offset(offset).limit(limit))).mappings().all()
+            return CaseAttachmentPage(items=[view(row) for row in rows], total=total,
+                next_offset=offset + len(rows) if offset + len(rows) < total else None,
+                observed_at=await store.now())
+
+    async def read(self, tenant_id, case_id, attachment_id):
+        async with self.transaction(tenant_id, readonly=True) as store:
+            await store.case(case_id, lock=False)
+            row = await store.one(select(F).where(*self.scope(store, case_id), F.c.id == attachment_id))
+            if row is None:
+                raise StoreError("case_attachment_not_found", 404)
+            return view(row)
diff --git a/services/api/app/socai2/case_context_input.py b/services/api/app/socai2/case_context_input.py
new file mode 100644
index 000000000..3f740cd00
--- /dev/null
+++ b/services/api/app/socai2/case_context_input.py
@@ -0,0 +1,77 @@
+"""Business views of frozen H revisions and historical judgments, never prose edits."""
+import copy
+
+from .baseline_store import digest
+
+
+def kind(ref):
+    path = (ref.get("source_path") or "").split(".")
+    if ref["type"] == "result":
+        return "prior_result"
+    if ref["type"] != "artifact":
+        return None
+    if len(path) == 4 and path[1] == "tasks" and path[3] == "revision":
+        return "human_feedback"
+    if len(path) == 3 and path[1] == "adopted_task_revisions":
+        return "human_feedback"
+    if len(path) == 3 and path[1] == "prior_results":
+        return "prior_result"
+    return "current_assessment" if path == ["$", "current_assessment"] else None
+
+
+def select(ref, value, config, omissions):
+    category = kind(ref)
+    if category is None or not isinstance(value, dict):
+        return value
+    rule = config["context_input_selection"][category]
+    result = copy.deepcopy(value)
+
+    def remove(key, reason):
+        if key in result:
+            omissions.append({"ref": ref, "field": key, "reason": reason, "value_sha256": digest(result.pop(key))})
+
+    for key in rule["omit"]:
+        remove(key, "context_field_not_needed_for_model_task")
+    for key in rule["empty"]:
+        if result.get(key) is None or result.get(key) == "":
+            remove(key, "empty_context_optional")
+    if category == "prior_result" and (value.get("validation_state", "accepted") != "accepted"
+            or value.get("conclusion_state") == "unavailable" or not value.get("conclusion")):
+        remove("conclusion", "no_accepted_historical_conclusion")
+        result["conclusion_state"] = "unavailable"
+    return result
+
+
+def metadata(ref, original, config):
+    category = kind(ref)
+    if category is None or not isinstance(original, dict):
+        return {}
+    path = ref.get("source_path") or ""
+    use = ("adopted_feedback" if path.startswith("$.adopted_task_revisions.") else
+           "selected_comparison" if ref["type"] == "result" else category)
+    result = {"context_kind": category, "context_label": config["context_input_selection"]["labels"][use]}
+    identity = original.get("id") or (ref["id"] if ref["type"] == "result" else None)
+    if identity:
+        result["context_identity"] = str(identity)
+    if category == "human_feedback" and isinstance(original.get("result_scope"), dict):
+        result["original_scope"] = copy.deepcopy(original["result_scope"])
+    if category == "prior_result" and original.get("member_deliveries"):
+        # Only original membership is available here. Do not invent the old
+        # time/object scope; C6 receives that separately from frozen comparison.
+        result["original_scope"] = {"alert_ids": sorted({str(m["alert_id"]) for m in original["member_deliveries"]})}
+    return result
+
+
+def scope_key(row):
+    return "result_scope" if row.get("context_kind") == "human_feedback" else "declared_scope"
+
+
+def group_key(row):
+    if not row.get("context_identity"):
+        return None
+    return ("frozen_context", row["context_kind"], row["context_identity"], row["ref"]["role"],
+            tuple(row["alert_ids"]), digest(row.get("original_scope")), digest(row["value"]))
+
+
+def human_refs(value):
+    return [(key, value[key]) for key in ("source_refs", "result_source_refs") if key in value]
diff --git a/services/api/tests/test_socai2_case_adoption_pg.py b/services/api/tests/test_socai2_case_adoption_pg.py
