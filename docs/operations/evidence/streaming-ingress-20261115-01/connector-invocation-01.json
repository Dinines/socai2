  "script": "import json,subprocess,sys\nfrom datetime import datetime,timezone\nv=json.load(sys.stdin);c=v['config'];s=v['source'];p=c['postgres']\nsql=\"\"\"BEGIN;\nSET LOCAL lock_timeout='3s'; SET LOCAL statement_timeout='30s';\nINSERT INTO public.connectors(id,tenant_id,name,connector_type,category,is_enabled,auth_config,connector_config,health_status,events_ingested,events_dropped,error_count,oauth_provisioned,oauth_refresh_failures,tags,created_at,updated_at)\nVALUES (:'connector_id'::uuid,:'tenant_id'::uuid,:'name',:'connector_type',:'category',:'is_enabled'::boolean,'{}'::jsonb,:'connector_config'::jsonb,:'health_status',0,0,0,false,0,'[]'::jsonb,now(),now());\nCOMMIT;\nBEGIN READ ONLY;\nSET LOCAL ROLE :\"writer_role\";\nSELECT set_config('app.current_tenant_id',:'tenant_id',true);\nSELECT json_build_object('connector_id',id,'tenant_id',tenant_id,'name',name,'connector_type',connector_type,'health_status',health_status,'is_enabled',is_enabled) FROM public.connectors WHERE id=:'connector_id'::uuid AND tenant_id=:'tenant_id'::uuid;\nROLLBACK;\n\"\"\"\nargs=['docker','exec','-i',p['container'],'psql','-XwAtq','-v','ON_ERROR_STOP=1','-U',p['admin_role'],'-d',p['database'],'-v','writer_role='+p['writer']]\nfor k,x in s.items():\n if k in {'connector_id','tenant_id','name','connector_type','category','is_enabled','connector_config','health_status'}:args+=['-v',k+'='+(json.dumps(x) if isinstance(x,(dict,bool)) else x)]\nr=subprocess.run(args,input=sql,capture_output=True,text=True,timeout=c['timeout_seconds'],check=False)\nif r.returncode:raise RuntimeError('connector_provision_failed:'+r.stderr[-600:])\nactual=json.loads(r.stdout.strip().splitlines()[-1]);assert actual['connector_id']==s['connector_id'] and actual['tenant_id']==s['tenant_id']\nprint(json.dumps({'status':'passed','observed_at':datetime.now(timezone.utc).isoformat(),'batch_id':s['batch_id'],'candidate_id':s['candidate_id'],'database':p['database'],'read_as':p['writer'],'source':actual,'business_analysis_records_written':0,'model_calls':0},indent=2))\n",
