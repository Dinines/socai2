FROM python@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce
WORKDIR /opt/investigation-test
COPY ["deploy/investigation-test/acceptance-requirements.lock", "/tmp/acceptance-requirements.lock"]
RUN ["python", "-c", "import sys; assert sys.version.split()[0] == '3.11.17'"]
RUN ["python", "-m", "pip", "install", "--no-cache-dir", "--disable-pip-version-check", "--only-binary=:all:", "--index-url", "https://pypi.org/simple", "--require-hashes", "-r", "/tmp/acceptance-requirements.lock"]
RUN ["python", "-m", "pip", "check"]
COPY . .
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
ENTRYPOINT ["python", "tools/testdata/acceptance.py"]
CMD ["--help"]
