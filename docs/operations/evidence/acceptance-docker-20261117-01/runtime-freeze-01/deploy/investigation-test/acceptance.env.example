# Copy outside the source tree and explicitly set the host directories.
# Prefer the verified RepoDigest from the delivered image receipt for IMAGE.
ACCEPTANCE_PROJECT=socai2-acceptance
ACCEPTANCE_IMAGE=socai2-investigation-acceptance:20261117-3d03
ACCEPTANCE_PLATFORM=linux/amd64
ACCEPTANCE_USER=10001:10001
ACCEPTANCE_NETWORK=none
ACCEPTANCE_CPUS=1.0
ACCEPTANCE_MEMORY=512m
ACCEPTANCE_PIDS=128
ACCEPTANCE_TMPFS_SIZE=64m
ACCEPTANCE_MATERIALS_DIR=/absolute/path/to/materials
ACCEPTANCE_CONFIG_DIR=/absolute/path/to/private-config
ACCEPTANCE_RESULTS_DIR=/absolute/path/to/results
ACCEPTANCE_MATERIALS_TARGET=/materials
ACCEPTANCE_CONFIG_TARGET=/run/acceptance-config
ACCEPTANCE_RESULTS_TARGET=/results
