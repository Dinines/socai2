\"N4_S147\", \"N4_S148\", \"N4_S149\"],\n        \"limitations\": [\"缺乏目的 IP 信誉数据\", \"缺乏账号操作基线\"]\n      },\n      {\n        \"id\": \"authorization\",\n        \"state\": \"unresolved\",\n        \"answer\": \"无明确授权证据。未找到审批记录、权限基线或业务需求文档。\",\n        \"evidence_ids\": [\"N4_S146\", \"N4_S147\"],\n        \"limitations\": [\"未提供授权材料，不能因未提供而断定无授权\"]\n      },\n      {\n        \"id\": \"impact\",\n        \"state\": \"unresolved\",\n        \"answer\": \"未观察到实际影响。进程启动成功不代表数据外传，流量结果未知不代表数据泄露。\",\n        \"evidence_ids\": [\"N4_S11\", \"N4_S73\"],\n        \"limitations\": [\"无法确认连接是否建立\", \"无法确认是否读取了敏感数据\"]\n      }\n    ],\n    \"domains\": [\n      {\n        \"name\": \"identity\",\n        \"applicability\": \"applicable\",\n        \"reason\": \"涉及服务账号 svc-app-1afa1f56 的行为及授权状态。\",\n        \"alert_ids\": [\"A1\", \"A2\"]\n      ,\n      \"finding_ids\": [\"F5\"]\n      ,\n      \"limitations\": [\"缺乏账号权限基线文档或运维审批记录\"]\n      },\n      {\n        \"name\": \"cloud\",\n        \"applicability\": \"not_applicable\",\n        \"reason\": \"当前材料未涉及云环境配置、资源变更或云原生攻击特征。\",\n        \"alert_ids\": [\"A1\", \"A2\"]\n      ,\n      \"finding_ids\": []\n      ,\n      \"limitations\": [\"无相关证据\"]\n      },\n      {\n        \"name\": \"phishing\",\n        \"applicability\": \"not_applicable\",\n        \"reason\": \"当前材料未涉及钓鱼邮件、恶意链接点击或凭证窃取行为。\",\n        \"alert_ids\": [\"A1\", \"A2\"]\n      ,\n      \"finding_ids\": []\n      ,\n      \"limitations\": [\"无相关证据\"]\n      },\n      {\n        \"name\": \"insider\",\n        \"applicability\": \"applicable\",\n        \"reason\": \"涉及服务账号（可能代表内部系统或自动化运维）对外发起探测的行为性质判断。\",\n        \"alert_ids\": [\"A1\", \"A2\"]\n      ,\n      \"finding_ids\": [\"F1\", \"F2\", \"F3\", \"F4\", \"F5\"]\n      ,\n      \"limitations\": [\"无法区分是正常运维探测还是恶意内部扫描\"]\n      }\n    ],\n    \"conflicts\": []\n  ,\n  \"followups\": [\n    {\n      \"question_id\": \"authorization\",\n      \"alert_ids\": [\"A1\", \"A2\"],\n      \"mode\": \"human\",