_S83","N4_S110"]}],"summary":"本案核心事实为服务账号 svc-app-1afa1f56 在主机 host-app-7e78aefa 上成功启动 curl 进程发起 HTTP HEAD 探测请求至外部 IP 198.51.100.171，约 20 分钟后观测到对应的网络流量（TCP/443）。现有证据链在‘意图’与‘结果’之间存在断裂：进程启动成功不代表命令执行完毕或获取了响应；网络流量观测结果标记为 unknown，无法确认连接是否建立、是否读取了敏感数据或是否造成系统影响。目的 IP 属性不明（无资产关联、无威胁情报），账号授权状态未定（无审批记录、无权限基线）。A1 与 A2 告警通过相同主机、账号、目标 IP 及时间邻近性建立关联，推断为同一业务会话，但时间间隔较长，因果推断存在不确定性。","findings":[{"id":"F1","state":"observed","alert_ids":["eae52a23-632a-5cfe-9d6f-7f3e70f18847"],"statement":"[A2/原记录2]\n[N4_S63] time=\"2026-11-17T09:16:44+00:00\"\n[N4_S64] actor.user.name=\"svc-app-1afa1f56\"\n[N4_S65] device.name=\"host-app-7e78aefa\"\n[N4_S68] process.name=\"curl\"\n[N4_S72] activity.action=\"process_start\"\n[N4_S73] activity.outcome=\"success\"","counter_ids":[],"limitations":["仅记录进程启动动作，未记录命令执行结果或返回数据","无法确认 curl 命令是否完整执行完毕或获取了响应内容"],"support_ids":["N4_S63","N4_S64","N4_S65","N4_S68","N4_S72","N4_S73"],"alternatives":[]},{"id":"F2","state":"observed","alert_ids":["557b7a3c-5271-5130-b9d5-eed824ff76b0"],"statement":"[A1/原记录1]\n[N4_S3] time=\"2026-11-17T09:35:44+00:00\"\n[N4_S4] actor.user.name=\"svc-app-1afa1f56\"\n[N4_S5] device.name=\"host-app-7e78aefa\"\n[N4_S10] activity.action=\"network_flow_observed\"\n[N4_S11] activity.outcome=\"unknown\"\n[N4_S21] dst_endpoint.ip=\"198.51.100.171\"\n[N4_S22] dst_endpoint.port=443\n[N4_S23] src_endpoint.ip=\"192.0.2.171\"","counter_ids":[],"limitations":["流量观测结果标记为 unknown，无法确认连接状态","无法确认流量内容是否包含敏感数据"],"support_ids":["N4_S3","N4_S4","N4_S5","N4_S10","N4_S11","N4_S21","N4_S22","N4_S23"],"alternatives":[]},{"id":"F3","state":"inferred","alert_ids":["557b7a3c-5271-5130-b9d5-eed824ff76b0","eae52a23-632a-5cfe-9d6f-7f3e70f18847"],"statement":"A2 中的进程启动行为与 A1 中的网络流量观测在时间（间隔约 20 分钟）、主机、账号及目标 IP 上高度一致，推断两者属于同一业务会话或关联操作序列。","counter_ids":[],"limitations":["时间间隔较长，不能直接证明因果","缺乏会话保持或中间状态证据"],"support_ids":["N4_S63","N4_S3","N4_S64","N4_S4","N4_S21","N4_S23"],"alternatives":["两次事件可能无直接关联，例如 A1 为其他无关流量，或 A2 进程启动后未产生 A1 所示流量"]},{"id":"F4","state":"unresolve