@@ -0,0 +1,170 @@
+"""Read complete top-level JSON values from a C3 reply; never repair a value."""
+import json
+
+from .baseline_analysis_contract import AnalysisRejected
+from .runtime_policy import C3_SECTIONS as SECTIONS
+
+
+class Incomplete(Exception):
+    pass
+
+
+class Reader:
+    def __init__(self, text):
+        self.text, self.pos = text, 0
+        self.values, self.spans = {}, {}
+        self.close_only = False
+
+    def peek(self):
+        return self.text[self.pos:self.pos + 1]
+
+    def space(self):
+        while self.peek() and self.peek() in " \t\r\n":
+            self.pos += 1
+
+    def need(self, char):
+        self.space()
+        if not self.peek():
+            raise Incomplete
+        if self.peek() != char:
+            raise AnalysisRejected("c3_completion_json_invalid")
+        self.pos += 1
+
+    def string(self):
+        start = self.pos
+        self.need('"')
+        while self.peek():
+            char = self.peek()
+            self.pos += 1
+            if char == '"':
+                return json.loads(self.text[start:self.pos])
+            if ord(char) < 32:
+                raise AnalysisRejected("c3_completion_json_invalid")
+            if char == "\\":
+                if not self.peek():
+                    raise Incomplete
+                escape = self.peek()
+                self.pos += 1
+                if escape == "u":
+                    for _ in range(4):
+                        if not self.peek():
+                            raise Incomplete
+                        if self.peek() not in "0123456789abcdefABCDEF":
+                            raise AnalysisRejected("c3_completion_json_invalid")
+                        self.pos += 1
+                elif escape not in '"\\/bfnrt':
+                    raise AnalysisRejected("c3_completion_json_invalid")
+        raise Incomplete
+
+    def number(self):
+        if self.peek() == "-":
+            self.pos += 1
+        if not self.peek():
+            raise Incomplete
+        if self.peek() == "0":
+            self.pos += 1
+        elif self.peek() in "123456789":
+            while self.peek() and self.peek() in "0123456789":
+                self.pos += 1
+        else:
+            raise AnalysisRejected("c3_completion_json_invalid")
+        for marker in (".", "eE"):
+            if self.peek() and self.peek() in marker:
+                self.pos += 1
+                if marker == "eE" and self.peek() and self.peek() in "+-":
+                    self.pos += 1
+                if not self.peek():
+                    raise Incomplete
+                if self.peek() not in "0123456789":
+                    raise AnalysisRejected("c3_completion_json_invalid")
+                while self.peek() and self.peek() in "0123456789":
+                    self.pos += 1
+
+    def value(self):
+        self.space()
+        char = self.peek()
+        if not char:
+            raise Incomplete
+        if char == '"':
+            self.string()
+        elif char == "{":
+            self.object()
+        elif char == "[":
+            self.pos += 1
+            self.space()
+            if self.peek() == "]":
+                self.pos += 1
+                return
+            while True:
+                self.value()
+                self.space()
+                if self.peek() == "]":
+                    self.pos += 1
+                    return
+                self.need(",")
+        elif char in "-0123456789":
+            self.number()
+        else:
+            literal = {"t": "true", "f": "false", "n": "null"}.get(char)
+            if literal is None:
+                raise AnalysisRejected("c3_completion_json_invalid")
+            tail = self.text[self.pos:self.pos + len(literal)]
+            if not literal.startswith(tail):
+                raise AnalysisRejected("c3_completion_json_invalid")
+            if len(tail) < len(literal):
+                raise Incomplete
+            self.pos += len(literal)
+
+    def object(self, *, root=False):
+        self.need("{")
+        self.space()
+        if self.peek() == "}":
+            self.pos += 1
+            return
+        seen = set()
+        while True:
+            self.space()
+            key = self.string()
+            if key in seen:
+                raise AnalysisRejected("duplicate_json_key")
+            seen.add(key)
+            if root and key not in SECTIONS:
+                raise AnalysisRejected("c3_completion_extra_section")
+            self.need(":")
+            self.space()
+            start = self.pos
+            self.value()
+            if root:
+                self.values[key] = json.loads(self.text[start:self.pos])
+                self.spans[key] = [start, self.pos]
+            self.space()
+            if self.peek() == "}":
+                self.pos += 1
+                return
+            if root and not self.peek():
+                self.close_only = set(self.values) == set(SECTIONS)
+            self.need(",")
+
+
+def read_sections(content):
+    if not isinstance(content, str):
+        raise AnalysisRejected("c3_completion_json_invalid")
+    reader = Reader(content)
+    closed = False
+    try:
+        reader.object(root=True)
+        reader.space()
+        if reader.peek():
+            raise AnalysisRejected("c3_completion_json_invalid")
+        closed = True
+    except Incomplete:
+        pass
+    except (RecursionError, ValueError) as exc:
+        if isinstance(exc, AnalysisRejected):
+            raise
+        raise AnalysisRejected("c3_completion_json_invalid") from None
+    missing = [key for key in SECTIONS if key not in reader.values]
+    if not reader.values or (not missing and not closed and not reader.close_only):
+        raise AnalysisRejected("c3_completion_no_reliable_sections")
+    return {"retained": reader.values, "missing": missing, "value_spans": reader.spans,
+            "outer_closed": closed, "closing_delimiter_only": reader.close_only}
