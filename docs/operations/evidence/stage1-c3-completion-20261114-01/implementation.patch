+        run = await steps.locked(store, case_id, run_id)
+        attempts = (await store.db.execute(select(S).where(*store.where(S, S.c.run_id == run_id,
+            S.c.parent_step_id == stage_id, S.c.kind == "model")))).mappings().all()
+        if len(attempts) != 1 or attempts[0]["id"] != model_id or attempts[0]["state"] not in {"completed", "failed"}:
+            return initial
