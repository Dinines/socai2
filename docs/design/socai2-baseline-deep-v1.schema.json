{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:socai2:baseline-deep:v1",
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "supported",
            "unresolved"
          ],
          "title": "State",
          "type": "string"
        },
        "text": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "support_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Support Ids",
          "type": "array"
        },
        "counter_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Counter Ids",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Alternatives",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 1200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "state",
        "text",
        "support_ids",
        "counter_ids",
        "alternatives",
        "limitations"
      ],
      "title": "Answer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Question Id",
      "type": "string"
    },
    "action": {
      "enum": [
        "query",
        "answer",
        "handoff"
      ],
      "title": "Action",
      "type": "string"
    },
    "binding_id": {
      "anyOf": [
        {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Binding Id"
    },
    "reason": {
      "maxLength": 1200,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "answer": {
      "anyOf": [
        {
          "$ref": "#/$defs/Answer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "question_id",
    "action",
    "binding_id",
    "reason",
    "answer"
  ],
  "title": "Decision",
  "type": "object"
}
