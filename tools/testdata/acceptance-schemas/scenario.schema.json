{
  "$defs": {
    "CasePlan": {
      "additionalProperties": false,
      "properties": {
        "alert_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Alert Refs",
          "type": "array"
        },
        "check_after_parts": {
          "items": {
            "pattern": "^part[1-9][0-9]*$",
            "type": "string"
          },
          "title": "Check After Parts",
          "type": "array"
        },
        "create_after_part": {
          "pattern": "^part[1-9][0-9]*$",
          "title": "Create After Part",
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "scope": {
          "enum": [
            "incident",
            "alerts"
          ],
          "title": "Scope",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "key",
        "title",
        "create_after_part",
        "scope",
        "alert_refs",
        "check_after_parts"
      ],
      "title": "CasePlan",
      "type": "object"
    },
    "Part": {
      "additionalProperties": false,
      "properties": {
        "check_level": {
          "enum": [
            "alert",
            "incident",
            "case"
          ],
          "title": "Check Level",
          "type": "string"
        },
        "context_required": {
          "title": "Context Required",
          "type": "boolean"
        },
        "id": {
          "pattern": "^part[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "check_level",
        "context_required"
      ],
      "title": "Part",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/CasePlan"
      },
      "title": "Cases",
      "type": "array"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/Part"
      },
      "minItems": 1,
      "title": "Parts",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "socai2.acceptance-scenario.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "parts",
    "cases"
  ],
  "title": "Scenario",
  "type": "object"
}
