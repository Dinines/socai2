{
  "additionalProperties": false,
  "properties": {
    "database_url_file": {
      "minLength": 1,
      "title": "Database Url File",
      "type": "string"
    },
    "expected_database": {
      "minLength": 1,
      "title": "Expected Database",
      "type": "string"
    },
    "expected_user": {
      "minLength": 1,
      "title": "Expected User",
      "type": "string"
    },
    "schema_name": {
      "pattern": "^[a-z_][a-z0-9_]*$",
      "title": "Schema Name",
      "type": "string"
    },
    "ssl": {
      "enum": [
        "require",
        "verify-ca",
        "verify-full",
        "disable"
      ],
      "title": "Ssl",
      "type": "string"
    },
    "connect_timeout_seconds": {
      "exclusiveMinimum": 0,
      "title": "Connect Timeout Seconds",
      "type": "number"
    },
    "query_timeout_seconds": {
      "exclusiveMinimum": 0,
      "title": "Query Timeout Seconds",
      "type": "number"
    }
  },
  "required": [
    "database_url_file",
    "expected_database",
    "expected_user",
    "schema_name",
    "ssl",
    "connect_timeout_seconds",
    "query_timeout_seconds"
  ],
  "title": "PostgresConnection",
  "type": "object"
}
