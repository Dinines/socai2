        "alert": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Alert",
          "type": "object"
        },
        "membership": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Membership",
          "type": "object"
