    "case_id",
    "captured_at",
    "scope",
    "case",
    "alerts",
    "incidents",
    "tasks",
    "current_assessment",
    "assessment_members",
    "assessment_sources",
    "prior_results",
    "adopted_task_revisions",
    "adopted_artifacts",
    "questions",
    "omissions",
    "citation_roles"
