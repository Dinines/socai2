        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "triage_freshness": {
          "default": "unverified",
          "enum": [
            "current",
            "stale",
            "unverified",
            "unavailable"
          ],
          "title": "Triage Freshness",
          "type": "string"
