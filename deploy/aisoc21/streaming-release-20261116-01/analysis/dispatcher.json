{
  "enabled": true,
  "tenant_id": "00000000-0000-0000-0000-000000000001",
  "database_url_file": "/run/secrets/analysis-database-url",
  "database_connect_args": {
    "ssl": "require",
    "timeout": 5,
    "command_timeout": 30,
    "server_settings": {
      "statement_timeout": "30000",
      "lock_timeout": "3000"
    }
  },
  "database_pool_size": 5,
  "redis_url_file": "/run/secrets/analysis-redis-url",
  "redis_socket_timeout_seconds": 5,
  "redis_connect_timeout_seconds": 5,
  "lifecycle_policy_file": "/run/analysis/lifecycle.json",
  "executor_factory": "app.socai2.analysis_case_executor:executors",
  "executor_config_file": "/run/analysis/executors.json",
  "dispatch": {
    "namespace": "socai2-analysis-production",
    "max_running_tasks": 1,
    "poll_interval_seconds": 60,
    "execution_timeout_seconds": 3600,
    "replenish_limit": 100,
    "priorities": [
      "case_investigation",
      "alert_triage",
      "incident_diagnosis",
      "knowledge_sync"
    ],
    "receipt_directory": "/var/lib/analysis/completions",
    "lock_file": "/var/lib/analysis/dispatch.lock"
  }
}
