{
  "target": "sting-infra21",
  "release": "c173-release-20261121-03",
  "deployment_id": "c173-kafka-plaintext-20261121-01",
  "deployments_directory": "/opt/sting-aisoc-socai2/deployments",
  "broker_container": "sting-infra21-kafka-1",
  "primary_network": "socai2_default",
  "broker_network": "sting-infra21_default",
  "primary_gateway_priority": 1,
  "clients": {
    "fusion": "socai2-fusion-c173-release-20261121-03",
    "ueba": "socai2-ueba-1"
  },
  "environment": {
    "KAFKA_BOOTSTRAP_SERVERS": "kafka:29092",
    "KAFKA_SECURITY_PROTOCOL": "PLAINTEXT",
    "AISOC_ALLOW_CLEARTEXT_KAFKA": "1"
  },
  "validation": {
    "topic_prefix": "lyc.c173.kafka-plaintext",
    "retention_ms": 3600000,
    "kafka_timeout_seconds": 12,
    "readiness_timeout_seconds": 60,
    "stop_grace_seconds": 30
  }
}
