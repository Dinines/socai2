WORKDIR /opt/investigation
COPY services/api/app ./app
ENV PYTHONPATH=/opt/investigation PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
ENTRYPOINT []
CMD ["uvicorn", "app.investigation_v2.application:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
