# Load values from the explicitly selected private runtime file; never commit a real DSN.
# For 21, release_12.py maps processing DATABASE_URL into SOCAI2_CASE_DATABASE_URL.
# DATABASE_URL remains the existing general API authentication/reader connection.
SOCAI2_CASE_API_ENABLED=true
SOCAI2_PAGE_READ_ENABLED=true
SOCAI2_CASE_DATABASE_URL=
# Set an explicit PostgreSQL driver, host, port, database, role and TLS parameters.
# A missing writer connection returns case_write_database_not_configured on writes.
# Keep Case source selection explicit, matching the selected processing profile.
SOCAI2_SOURCE_UEBA_ENABLED=true
SOCAI2_SOURCE_KNOWLEDGE_ENABLED=true
SOCAI2_SOURCE_GRAPH_ENABLED=false
SOCAI2_SOURCE_PRODUCT_HOST_ENABLED=false
# Set to the lake database selected by that profile; no environment fallback.
SOCAI2_LAKE_DATABASE=
