{
  "version": "socai2.lake-alert-delivery.v1",
  "enabled": false,
  "selection_profile_file": "../lake-alert-selection-4a/selection.example.json",
  "receive_profile_file": "../lake-alert-receive-4b/receive.example.json",
  "connection_file": "private/connections.json",
  "poll_interval_seconds": 10,
  "max_deliveries_per_cycle": 20,
  "statement_timeout_seconds": 120,
  "runtime": {
    "dedup_window_seconds": 3600,
    "correlation_window_seconds": 3600,
    "max_alerts_per_incident": 20,
    "confidence_enabled": false,
    "log_level": "WARNING"
  },
  "read_limits": {
    "max_records": 100000,
    "max_result_bytes": 134217728,
    "query_timeout_seconds": 30,
    "connect_timeout_seconds": 5,
    "send_receive_timeout_seconds": 30
  }
}
