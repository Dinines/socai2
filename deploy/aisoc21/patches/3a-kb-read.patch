+
+def _date(value: Any) -> datetime:
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError("invalid KB timestamp")
+    result = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    if result.tzinfo is None:
