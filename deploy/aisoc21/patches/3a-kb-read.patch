+    read['model_citations'] = cited
+    read['unresolvable_citations'] = sorted(set(cited) - available)
+    read['cited_sources'] = [deepcopy(citation) for citation in read.get('citations', []) if citation.get('marker') in set(cited) & available]
 
 
