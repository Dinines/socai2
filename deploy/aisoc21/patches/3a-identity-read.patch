+
+    def test_account_paths_have_no_global_label_tenant_exception(self) -> None:
+        query = module._IDENTITY_BY_ACCOUNT_CYPHER
+        assert "$global_labels" not in query and "labels(" not in query
+        assert "tenant_id IS NULL" not in query
+        for variable in ("i", "e", "d", "mgr"):
+            assert f"{variable}.tenant_id = $tenant_id" in query
+
+    def test_cutoff_classification_precedes_order_and_limit(self) -> None:
+        query = module._IDENTITY_BY_ACCOUNT_CYPHER
+        assert "WITH DISTINCT i, e, d, mgr" in query
+        assert "IS :: ZONED DATETIME" in query
+        assert "datetime(" not in query
+        assert query.index("c.stamp <= $as_of") < query.index("ORDER BY") < query.index("LIMIT $limit")
+        assert "collect(c.row) AS identities" in query
+        assert "size(candidates) AS candidate_count" in query
+        assert "AS excluded_unverifiable_import" in query
+
+    def test_stable_node_path_prevents_display_field_distinct_collapse(self) -> None:
+        query = module._IDENTITY_BY_ACCOUNT_CYPHER
+        for variable in ("i", "e", "d", "mgr"):
+            assert f"elementId({variable})" in query
+        assert "c.row.identity_id" in query and "c.row.employee_id" in query
+        assert "c.row.department_id" in query and "c.row.manager_id" in query
+
