+    async def _apply_signal(self, tenant_id: UUID, sig: EntitySignal) -> tuple[EntityRiskRecord, bool]:
+        suffix = f"{tenant_id}:{sig.entity_type}:{sig.entity_value}"
+        key, seen_key = _ENTITY_PREFIX + suffix, _SEEN_PREFIX + suffix
+        # Watch both keys: a contribution and its claim must commit together.
+        # A separate SET NX before _save would lose risk on a failed write.
+        for attempt in range(32):
+            try:
+                async with self._redis.pipeline(transaction=True) as pipe:
+                    await pipe.watch(key, seen_key)
+                    record = await self._load(str(tenant_id), sig.entity_type, sig.entity_value, client=pipe)
+                    if record is not None and (
+                        sig.alert_id in record.contributing_alerts or await pipe.sismember(seen_key, sig.alert_id)
+                    ):
+                        return record, False
+                    # Seed only observable legacy membership; older truncated
+                    # history is unknown and must not be presented as recovered.
+                    prior_ids = record.contributing_alerts[:] if record else []
+                    record = self._accumulate(tenant_id, sig, record)
+                    newly_promoted = record.score >= self._threshold and record.promoted_at is None
+                    if newly_promoted:
+                        record.promoted_at = record.last_seen
+                    pipe.multi()
+                    self._queue_save(pipe, record)
+                    pipe.sadd(seen_key, *prior_ids, sig.alert_id)
+                    pipe.expire(seen_key, self._window)
+                    if newly_promoted:
+                        promoted_key = _PROMOTED_KEY + str(tenant_id)
+                        pipe.zadd(promoted_key, {self._member(record): time.time()})
+                        pipe.expire(promoted_key, self._window)
+                    await pipe.execute()
+                    return record, newly_promoted
+            except WatchError:
+                if attempt == 31:
+                    raise
+                await asyncio.sleep(min(0.001 * (attempt + 1), 0.025))
+        raise AssertionError("unreachable")
