+class _FakePipeline:
+    """Serial test double; real-Redis acceptance covers WATCH concurrency/TTL."""
+
+    def __init__(self, redis):
+        self.redis = redis
+        self.commands = []
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *args):
+        pass
+
+    async def watch(self, *keys):
+        pass
+
+    async def hgetall(self, key):
+        return await self.redis.hgetall(key)
+
+    async def sismember(self, key, member):
+        return await self.redis.sismember(key, member)
+
+    def multi(self):
+        pass
+
+    def __getattr__(self, name):
+        def queue(*args, **kwargs):
+            self.commands.append((name, args, kwargs))
+            return self
+        return queue
+
+    async def execute(self):
+        if self.redis.fail_next_execute is not None:
+            exc, self.redis.fail_next_execute = self.redis.fail_next_execute, None
+            raise exc
+        return [await getattr(self.redis, name)(*args, **kwargs) for name, args, kwargs in self.commands]
 
 
