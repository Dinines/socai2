+def _source_time(raw: dict[str, Any], key: str) -> str:
+    text = _material_value(raw, key, max_chars=_MAX_SOURCE_TIME_CHARS)
+    value = raw.get(key)
+    if isinstance(value, str) and value:
+        try:
+            parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+        except ValueError:
+            return text + " [unparsed source timestamp; timezone not inferred]"
+        return text + (" [explicit UTC offset retained]" if parsed.utcoffset() is not None else " [timezone not provided; not assumed UTC]")
+    return text
 
 
